{
  "project_name": "Luan-Van-LightGBM-Parquet-Github-v2",
  "model_name": "lightgbm",
  "experiment_role": "baseline_control",
  "seed": 2026,
  "device": "cpu",
  "num_boost_round": 100,
  "early_stopping": false,
  "imbalance_handling": "none",
  "feature_selection": "none",
  "use_all_train_rows": true,
  "model_params": {
    "boosting_type": "gbdt",
    "objective": "multiclass",
    "learning_rate": 0.001,
    "num_leaves": 31,
    "max_depth": -1,
    "min_data_in_leaf": 20,
    "lambda_l1": 0.0,
    "lambda_l2": 0.1,
    "min_gain_to_split": 0.0,
    "max_bin": 255,
    "feature_fraction": 1.0,
    "bagging_fraction": 1.0,
    "bagging_freq": 0,
    "metric": ["multi_logloss", "multi_error"],
    "device_type": "cpu",
    "num_threads": 4,
    "deterministic": true,
    "force_col_wise": true,
    "force_row_wise": false,
    "seed": 2026,
    "bagging_seed": 2026,
    "feature_fraction_seed": 2026,
    "data_random_seed": 2026,
    "histogram_pool_size": 128.0,
    "use_quantized_grad": true,
    "num_grad_quant_bins": 16,
    "quant_train_renew_leaf": true,
    "verbosity": 1
  },
  "dataset": {
    "prepared_data_dir": "outputs/data",
    "require_safe_memory_profile": true,
    "loading_strategy": "parquet_sequence",
    "sequence_batch_rows": 4096,
    "sequence_row_group_cache_mb": 128,
    "free_raw_data": true
  },
  "checkpoint": {
    "interval_rounds": 10,
    "save_immutable_round_files": true,
    "local_keep_round_files": 2
  },
  "session": {
    "maximum_hours": 12.0,
    "stop_before_minutes": 30.0,
    "max_rounds_this_session": null
  },
  "s3": {
    "enabled": true,
    "upload_required": true,
    "max_retries": 5,
    "retry_base_seconds": 2.0,
    "bucket_env": "S3_BUCKET",
    "prefix_env": "S3_PREFIX",
    "region_env": "AWS_REGION",
    "fallback_region_env": "AWS_DEFAULT_REGION"
  },
  "logging": {
    "level": "INFO",
    "lightgbm_period": 1
  }
}
